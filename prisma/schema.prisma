generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")   // ✅ allowed in v5
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                 BigInt    @id @default(autoincrement())
  user_type          String    @db.VarChar(30)
  full_name          String    @db.VarChar(100)
  mobile             String    @unique @db.VarChar(10)
  is_mobile_verified Boolean?  @default(false)
  email              String?   @unique @db.VarChar(150)
  village            String    @db.VarChar(60)
  mandal             String    @db.VarChar(60)
  district           String    @db.VarChar(60)
  state              String    @db.VarChar(60)
  pincode            String?   @db.VarChar(6)
  address            String?   @db.VarChar(250)
  latitude           Decimal?  @db.Decimal(10, 8)
  longitude          Decimal?  @db.Decimal(11, 8)
  profile_photo      String?
  status             String?   @default("active") @db.VarChar(20)
  role               String?   @default("user") @db.VarChar(20)
  last_login         DateTime? @db.Timestamp(6)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  updated_at         DateTime? @default(now()) @db.Timestamp(6)
}
